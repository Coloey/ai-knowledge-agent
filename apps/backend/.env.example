APP_ENV=local
APP_NAME=AI Knowledge Agent
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
LOG_LEVEL=info

DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
DATABASE_POOL_MAX=20
QUEUE_REDIS_URL=redis://localhost:6379/0
CONTROL_REDIS_URL=redis://localhost:6379/1
QUEUE_CONCURRENCY=2

JWT_SECRET_KEY=local-only-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agent-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=52428800

TIKA_URL=http://localhost:9998
TIKA_TIMEOUT_MS=120000

AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
SSE_HEARTBEAT_SECONDS=15
