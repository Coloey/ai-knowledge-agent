APP_ENV=local
APP_NAME=AI Knowledge Agent
API_PREFIX=
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=agent-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=

EMBEDDING_DIMENSION=1536
SSE_HEARTBEAT_SECONDS=15
