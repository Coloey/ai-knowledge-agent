{
  "name": "ai-knowledge-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack AI knowledge management and SmartBar Agent project.",
  "scripts": {
    "dev": "pnpm --filter @agent/web dev",
    "build": "pnpm --filter @agent/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "backend:dev": "cd backend && uvicorn app.main:app --reload",
    "backend:worker": "cd backend && celery -A app.workers.celery_app worker -l info",
    "infra:dev": "docker compose -f infra/docker-compose.dev.yml up -d"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.4.13",
    "@rsbuild/plugin-less": "^1.3.5",
    "@rsbuild/plugin-react": "^1.3.5",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.2"
  }
}
